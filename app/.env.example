# NoClass™ PHP Procedural Framework — environment variables
# Copy to .env and fill in your values.

# APP_ENV defaults to 'production' in config.php (DEBUG off, no stack traces).
# Set to 'development' for local work.
APP_ENV=development
APP_DEBUG=true
APP_LOG=true

# BASE_URL must be the origin only — scheme + host + optional port.
# Do NOT include the subfolder path. BASE_URI (derived from SCRIPT_NAME)
# handles the subfolder automatically.
#
# Correct:   BASE_URL=http://localhost
# Correct:   BASE_URL=http://localhost:8080
# Correct:   BASE_URL=https://myapp.example.com
# WRONG:     BASE_URL=http://localhost/myapp  ← causes doubled URL paths
BASE_URL=http://localhost

USE_DB=false
DB_HOST=localhost
DB_PORT=3306
DB_NAME=noclass
DB_USER=root
DB_PASS=

CACHE_DRIVER=NONE

# Set to true when behind a reverse proxy (nginx, Cloudflare, AWS ALB)
# that sets X-Forwarded-Proto. Without this, is_https() ignores the header.
TRUST_PROXY=false
